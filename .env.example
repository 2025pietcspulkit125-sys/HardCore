# Optional local database override. Defaults to backend/venv/mailtrace_cases.db.
MAILTRACE_DB_PATH=

# Optional threat-intelligence providers. Leave blank for local deterministic analysis.
VIRUSTOTAL_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=
MAILTRACE_ALERT_THRESHOLD=80
ML_MODEL_PATH=

# Optional evidence-grounded AI Investigator provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mailbox ingestion. Provider credentials stay on the backend; never commit real values.
MAILBOX_PROVIDER=imap
MAILBOX_INGESTION_ENABLED=false
MAILBOX_POLL_INTERVAL_SECONDS=30
MAILBOX_MAX_MESSAGE_BYTES=26214400
MAILBOX_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Legacy names are also accepted for an existing Google OAuth setup:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/mail/oauth/google/callback
GMAIL_ACCESS_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_ACCESS_TOKEN=
MAILBOX_REDIRECT_URI=http://127.0.0.1:8000/api/mailbox/oauth/{provider}/callback
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_QUARANTINE_FOLDER=Quarantine
AUTO_QUARANTINE_ENABLED=false
HIGH_RISK_THRESHOLD=50
CRITICAL_RISK_THRESHOLD=75
LLM_PROVIDER=fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=15
